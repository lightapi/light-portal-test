# Non-secret defaults for portal-config-loc.
PORTAL_BASE_URL=https://localhost:8444
MCP_BASE_URL=https://localhost
LLM_PUBLIC_ALIAS=assistant-dev
EMBEDDING_QUERY_ALIAS=kb-query
EMBEDDING_INDEX_ALIAS=kb-index
EMBEDDING_SPACE_ID=nvidia-nemotron-3-embed-1b-float-v1
EMBEDDING_SPACE_REVISION=1
EMBEDDING_DIMENSION=2048
TLS_INSECURE=true
TOKEN_PROFILE=portal-admin
WORKFLOW_SMOKE_TOOL=workflow_mcp_smoke
CUSTOMER_360_TOOL=customer_360

# Promotion canary. Labels must exactly match the text shown in the Portal host
# selector. Match values must identify one visible row for each entity type.
PROMOTION_UI_BASE_URL=https://localhost:3000
PROMOTION_API_BASE_URL=https://localhost:3000
# PROMOTION_SOURCE_HOST_ID=
# PROMOTION_SOURCE_HOST_LABEL=domain / subdomain
# PROMOTION_TARGET_HOST_ID=
# PROMOTION_TARGET_HOST_LABEL=domain / subdomain
# PROMOTION_PLATFORM_MATCH=
# PROMOTION_PIPELINE_MATCH=
# PROMOTION_PIPELINE_VERSION=
# PROMOTION_PRODUCT_ID=
# PROMOTION_PRODUCT_VERSION=
PROMOTION_MINIMUM_MATCHING_ROWS=11
PROMOTION_SELECTION_ENTITY_TYPE=config
PROMOTION_SELECTION_ENTITY_LABEL=Config
PROMOTION_PROJECTION_TIMEOUT_MS=120000
# auto runs Hurl only with an explicit PORTAL_ACCESS_TOKEN; use required or skip
PROMOTION_API_PREFLIGHT=auto

# Supply this at runtime or add it only to your private
# ~/.config/lightapi/light-portal.env file.
# PORTAL_ACCESS_TOKEN=
# EMBEDDING_QUERY_ACCESS_TOKEN=
# EMBEDDING_INDEX_ACCESS_TOKEN=
# PROMOTION_E2E_EMAIL=
# PROMOTION_E2E_PASSWORD=
# PROMOTION_E2E_USER_TYPE=Employee
# PROMOTION_AUTH_STATE_FILE=/run/secrets/portal-playwright-state.json
# PROMOTION_REUSE_AUTH_STATE=true
# PORTAL_AUTO_LOGIN=auto
# PORTAL_TOKEN_MIN_TTL_SECONDS=300
