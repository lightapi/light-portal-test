# Non-secret defaults for portal-config-loc.
PORTAL_BASE_URL=https://localhost:8444
MCP_BASE_URL=https://localhost
LLM_PUBLIC_ALIAS=assistant-dev
EMBEDDING_QUERY_ALIAS=kb-query
EMBEDDING_INDEX_ALIAS=kb-index
EMBEDDING_SPACE_ID=nvidia-nemotron-3-embed-1b-float-v1
EMBEDDING_SPACE_REVISION=1
EMBEDDING_DIMENSION=2048
TLS_INSECURE=true
TOKEN_PROFILE=portal-admin
WORKFLOW_SMOKE_TOOL=workflow_mcp_smoke
CUSTOMER_360_TOOL=customer_360

# Promotion canary. Labels must exactly match the text shown in the Portal host
# selector. Match values must identify one visible row for each entity type.
PROMOTION_UI_BASE_URL=https://localhost:3000
PROMOTION_API_BASE_URL=https://localhost:3000
# PROMOTION_SOURCE_HOST_ID=
# PROMOTION_SOURCE_HOST_LABEL=domain / subdomain
# PROMOTION_TARGET_HOST_ID=
# PROMOTION_TARGET_HOST_LABEL=domain / subdomain
# PROMOTION_PLATFORM_MATCH=
# PROMOTION_PIPELINE_MATCH=
# PROMOTION_PIPELINE_VERSION=
# PROMOTION_PRODUCT_ID=
# PROMOTION_PRODUCT_VERSION=
PROMOTION_MINIMUM_MATCHING_ROWS=11
PROMOTION_SELECTION_ENTITY_TYPE=config
PROMOTION_SELECTION_ENTITY_LABEL=Config
PROMOTION_PROJECTION_TIMEOUT_MS=120000
# auto runs Hurl only with an explicit PORTAL_ACCESS_TOKEN; use required or skip
PROMOTION_API_PREFLIGHT=auto

# Supply this at runtime or add it only to your private
# ~/.config/lightapi/light-portal.env file.
# PORTAL_ACCESS_TOKEN=
# EMBEDDING_QUERY_ACCESS_TOKEN=
# EMBEDDING_INDEX_ACCESS_TOKEN=
# PROMOTION_E2E_EMAIL=
# PROMOTION_E2E_PASSWORD=
# PROMOTION_E2E_USER_TYPE=Employee
# PROMOTION_AUTH_STATE_FILE=/run/secrets/portal-playwright-state.json
# PROMOTION_REUSE_AUTH_STATE=true
# PORTAL_AUTO_LOGIN=auto
# PORTAL_TOKEN_MIN_TTL_SECONDS=300

# Dedicated destructive Gateway Tool publication lifecycle lane.
# WORKFLOW_MCP_E2E_HOST_ID=01964b05-552a-7c4b-9184-6857e7f3dc5f
# WORKFLOW_MCP_E2E_INSTANCE_ID=0ac8b305-722b-5c83-99eb-e475ec2bc9ea
# WORKFLOW_MCP_E2E_API_VERSION_ID=019e6231-5aa0-756c-a000-5b493ad49d0a
# WORKFLOW_MCP_E2E_INSTANCE_NAME=workflow-mcp-e2e-loc
# WORKFLOW_MCP_E2E_GATEWAY_URL=https://localhost:8445
# WORKFLOW_MCP_E2E_CONTAINER=workflow-mcp-test-gateway
# WORKFLOW_MCP_E2E_EMAIL=
# WORKFLOW_MCP_E2E_PASSWORD=

# MCP daily protocol lane (included in make all; no LLM calls).
# MCP_BASE_URL is the gateway origin, without /mcp.
MCP_DEMO_URL=http://localhost:8087/mcp
# Optional source regression target: make mcp-source
# MCP_SOURCE_WORKSPACE=/home/steve/workspace

# GitHub Gateway ACL reads and existing Workflow UI lane (make github-api).
# Authorized caller uses API_GATEWAY_E2E_* or the normal PROMOTION_E2E_* fallback.
# Set credentials only in private environment configuration.
# API_GATEWAY_E2E_BASE_URL=https://localhost:3000
# API_GATEWAY_E2E_EMAIL=
# API_GATEWAY_E2E_PASSWORD=
# API_GATEWAY_E2E_USER_TYPE=Employee
# API_GATEWAY_E2E_AUTH_STATE_FILE=/run/secrets/github-authorized-state.json
# GITHUB_API_GATEWAY_URL=https://localhost
# GITHUB_API_CA_FILE=/path/to/gateway-ca.pem
# GITHUB_API_GATEWAY_CONTAINER=light-gateway
# GITHUB_API_EVIDENCE_DB_CONTAINER=postgres
# GITHUB_API_GATEWAY_INSTANCE=portal-bff-loc
# Denied caller is the approved ke.hu@lightapi.net account, with exactly role user.
# Localhost login has the owner-approved local test default; private overrides win.
# Explicit empty credentials fail. A supplied state must be current and separate.
# GITHUB_API_DENIED_EMAIL=ke.hu@lightapi.net
# GITHUB_API_DENIED_PASSWORD=
# GITHUB_API_DENIED_USER_TYPE=Employee
# GITHUB_API_DENIED_AUTH_STATE_FILE=/run/secrets/github-denied-state.json
